{
  "hooks": {
    "after:init": [
      "pnpm --dir ../.. run lint",
      "pnpm run typecheck",
      "pnpm run build"
    ]
  },
  "git": {
    "requireCleanWorkingDir": true,
    "commitMessage": "Release server-logger v${version}",
    "tagName": "server-logger-v${version}",
    "tagAnnotation": "server-logger v${version}",
    "push": true
  },
  "github": {
    "release": false
  },
  "npm": {
    "publish": false
  }
}

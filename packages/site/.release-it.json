{
  "hooks": {
    "after:init": [
      "pnpm exec nx run-many -t lint typecheck build -p site"
    ]
  },
  "git": {
    "requireCleanWorkingDir": true,
    "commitMessage": "Release site v${version}",
    "tagName": "site-v${version}",
    "tagAnnotation": "site v${version}",
    "push": true
  },
  "github": {
    "release": false
  },
  "npm": {
    "publish": false
  }
}

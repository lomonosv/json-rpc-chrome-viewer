{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "extension",
  "projectType": "application",
  "sourceRoot": "packages/extension/src",
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "parallel": false,
        "commands": [
          "eslint --cache=true --cache-location=./.cache/eslint ./",
          "stylelint \"src/**/*.scss\""
        ]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "tsc -noEmit"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "inputs": [
        "production",
        "^production",
        { "env": "SENTRY_DSN" },
        { "env": "ENVIRONMENT" }
      ],
      "outputs": ["{projectRoot}/build"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "rm -rf build && node scripts/build.js && node scripts/envSubstitute.js"
      },
      "configurations": {
        "production": {
          "command": "rm -rf build && node scripts/build.js --release && node scripts/envSubstitute.js"
        }
      }
    }
  }
}

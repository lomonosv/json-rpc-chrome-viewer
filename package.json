{
  "name": "json-rpc-chrome-viewer",
  "version": "1.15.12",
  "description": "JSON RPC request dev tools",
  "main": "src/index.jsx",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.13.0",
      "onFail": "warn"
    }
  },
  "scripts": {
    "eslint": "eslint --cache=true --cache-location=./.cache/eslint ./",
    "stylelint": "stylelint \"src/**/*.scss\"",
    "lint": "pnpm run eslint && pnpm run stylelint",
    "clean": "rm -rf build",
    "build": "pnpm run clean && pnpm run lint && tsc -noEmit && node scripts/build.js && node scripts/envSubstitute.js",
    "release": "release-it",
    "build:logger": "pnpm --filter @json-rpc-chrome-viewer/server-logger run build",
    "typecheck:logger": "pnpm --filter @json-rpc-chrome-viewer/server-logger run typecheck",
    "release:logger": "cd packages/server-logger && release-it"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lomonosv/json-rpc-chrome-viewer.git"
  },
  "author": "lomonosv.developer@gmail.com",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/lomonosv/json-rpc-chrome-viewer/issues"
  },
  "homepage": "https://github.com/lomonosv/json-rpc-chrome-viewer#readme",
  "dependencies": {
    "@microlink/react-json-view": "^1.31.40",
    "@sentry/browser": "^11.7.0",
    "classnames": "^2.5.1",
    "copy-to-clipboard": "^4.0.2",
    "inversify": "^8.2.3",
    "json2ts": "^0.0.7",
    "re-resizable": "^6.11.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "reflect-metadata": "^0.2.2",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@release-it/bumper": "^8.0.1",
    "@sentry/esbuild-plugin": "^5.4.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "chrome-webstore-upload-cli": "4.0.2",
    "dotenv": "18.0.7",
    "esbuild": "^0.28.2",
    "esbuild-plugin-copy": "^2.1.1",
    "esbuild-sass-plugin": "^3.7.0",
    "eslint": "^9.39.5",
    "eslint-config-airbnb-extended": "^3.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.30",
    "postcss-modules": "^9.0.1",
    "postcss-scss": "^4.0.9",
    "release-it": "^21.1.1",
    "sass": "^1.105.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-scss": "^7.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}

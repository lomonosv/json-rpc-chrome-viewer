{
  "name": "json-rpc-chrome-viewer",
  "private": true,
  "description": "Workspace root for the JSON-RPC Chrome Viewer extension, its server logger and its site",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.13.0",
      "onFail": "warn"
    }
  },
  "scripts": {
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "dev:site": "nx run site:dev",
    "graph": "nx graph",
    "release:extension": "cd packages/extension && release-it",
    "release:logger": "cd packages/server-logger && release-it",
    "release:site": "cd packages/site && release-it"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lomonosv/json-rpc-chrome-viewer.git"
  },
  "author": "lomonosv.developer@gmail.com",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/lomonosv/json-rpc-chrome-viewer/issues"
  },
  "homepage": "https://json-rpc-chrome-viewer.lomonos.com.ua/",
  "devDependencies": {
    "@release-it/bumper": "^8.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^9.39.5",
    "eslint-config-airbnb-extended": "^3.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "nx": "^24.0.2",
    "release-it": "^21.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}

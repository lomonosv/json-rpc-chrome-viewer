{
  "name": "json-rpc-chrome-viewer",
  "private": true,
  "description": "Workspace root for the JSON-RPC Chrome Viewer extension, its server logger and its site",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.13.0",
      "onFail": "warn"
    }
  },
  "scripts": {
    "eslint": "eslint --cache=true --cache-location=./.cache/eslint ./",
    "stylelint": "pnpm --filter @json-rpc-chrome-viewer/extension run stylelint",
    "lint": "pnpm run eslint && pnpm run stylelint",
    "clean": "pnpm --filter @json-rpc-chrome-viewer/extension run clean",
    "build": "pnpm --filter @json-rpc-chrome-viewer/extension run build",
    "typecheck": "pnpm --filter @json-rpc-chrome-viewer/extension run typecheck",
    "release": "pnpm --filter @json-rpc-chrome-viewer/extension run release",
    "build:logger": "pnpm --filter @json-rpc-chrome-viewer/server-logger run build",
    "typecheck:logger": "pnpm --filter @json-rpc-chrome-viewer/server-logger run typecheck",
    "release:logger": "cd packages/server-logger && release-it",
    "dev:site": "pnpm run build:demo && pnpm --filter @json-rpc-chrome-viewer/site run dev",
    "build:site": "pnpm run build:demo && pnpm --filter @json-rpc-chrome-viewer/site run build",
    "typecheck:site": "pnpm --filter @json-rpc-chrome-viewer/site run typecheck",
    "release:site": "cd packages/site && release-it",
    "build:demo": "SENTRY_AUTH_TOKEN= pnpm --filter @json-rpc-chrome-viewer/extension run bundle"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lomonosv/json-rpc-chrome-viewer.git"
  },
  "author": "lomonosv.developer@gmail.com",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/lomonosv/json-rpc-chrome-viewer/issues"
  },
  "homepage": "https://json-rpc-chrome-viewer.lomonos.com.ua/",
  "devDependencies": {
    "@release-it/bumper": "^8.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^9.39.5",
    "eslint-config-airbnb-extended": "^3.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "release-it": "^21.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}

{
  "compilerOptions": {
    // TypeScript 6 defaults `strict` to true; pinned to preserve existing behaviour.
    "strict": false,
    "noImplicitAny": false,
    // TypeScript 6 no longer auto-includes every @types package.
    "types": [
      "chrome",
      "node"
    ],
    "module": "esnext",
    "target": "ES2022",
    "lib": [
      "es2022",
      "es2021",
      "es2021.promise",
      "dom"
    ],
    "jsx": "react",
    "allowJs": true,
    "moduleResolution": "bundler",
    "paths": {
      "~/logic/*": ["./src/logic/*"],
      "~/components/*": ["./src/components/*"]
    },
    "esModuleInterop": true,
    "sourceMap": true
  },
  "include": [
    "./src/**/*"
  ]
}
